<ui:FluentWindow x:Class="QZ.Frp.Client.Views.CreateTunnelWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="新建隧道"
                 Width="440"
                 Height="440"
                 MinWidth="400"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 WindowBackdropType="None"
                 FontFamily="{StaticResource AppFontFamily}"
                 FontSize="12"
                 Icon="pack://application:,,,/Assets/Icons/app.ico">
    <Grid Margin="24" Background="{StaticResource PageBackgroundBrush}">
        <Border Style="{StaticResource PanelStyle}" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="新建隧道" Style="{StaticResource PageTitleStyle}" />

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Text="隧道类型" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Types}"
                              SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="名称" Style="{StaticResource FieldLabelStyle}" />
                    <ui:TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="本地 IP" Style="{StaticResource FieldLabelStyle}" />
                    <ui:TextBox Text="{Binding LocalIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="127.0.0.1"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="本地端口" Style="{StaticResource FieldLabelStyle}" />
                    <ui:TextBox Text="{Binding LocalPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="22"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource DangerTextStyle}"
                               Margin="0,12,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <ui:Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
                    <ui:Button Content="创建"
                               Appearance="Primary"
                               Command="{Binding CreateCommand}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
