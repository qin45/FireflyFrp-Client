<ui:FluentWindow x:Class="FireflyFrp.Client.Views.ChangePasswordWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="修改密码"
                 Width="440"
                 Height="420"
                 MinWidth="400"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 WindowBackdropType="None"
                 FontFamily="{StaticResource AppFontFamily}"
                 FontSize="12"
                 Icon="pack://application:,,,/Assets/Icons/app.ico">
    <Grid Margin="24" Background="{StaticResource PageBackgroundBrush}">
        <Border Style="{StaticResource PanelStyle}" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="修改密码" Style="{StaticResource PageTitleStyle}" />

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Text="原密码" Style="{StaticResource FieldLabelStyle}" />
                    <ui:PasswordBox x:Name="OldPasswordInput"
                                    RevealButtonEnabled="True"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="新密码" Style="{StaticResource FieldLabelStyle}" />
                    <ui:PasswordBox x:Name="NewPasswordInput"
                                    RevealButtonEnabled="True"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="确认新密码" Style="{StaticResource FieldLabelStyle}" />
                    <ui:PasswordBox x:Name="ConfirmPasswordInput"
                                    RevealButtonEnabled="True"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource DangerTextStyle}"
                               Margin="0,12,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <ui:Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
                    <ui:Button Content="确认修改"
                               Appearance="Primary"
                               Command="{Binding ChangeCommand}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
