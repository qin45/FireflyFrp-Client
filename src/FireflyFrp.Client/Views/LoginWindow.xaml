<ui:FluentWindow x:Class="FireflyFrp.Client.Views.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="FireflyFrp"
                 Width="440"
                 Height="680"
                 MinWidth="400"
                 MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{StaticResource AppFontFamily}"
                 FontSize="12"
                 Icon="pack://application:,,,/Assets/Icons/app.ico"
                 Background="{DynamicResource PageBackgroundBrush}">

    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top"
                     Title="FireflyFrp"
                     Background="{DynamicResource PageBackgroundBrush}" />
        <Border Background="{DynamicResource PageBackgroundBrush}" Padding="24">
        <Grid>
            <Border Style="{StaticResource LoginCardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="FireflyFrp"
                               Style="{StaticResource PageTitleStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />

                    <StackPanel Visibility="{Binding IsServerUrlVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="服务端地址" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6" />
                        <ui:TextBox Text="{Binding ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="https://api.example.com"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>

                    <TextBlock Text="用户名" Style="{StaticResource FieldLabelStyle}" />
                    <ui:TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="密码" Style="{StaticResource FieldLabelStyle}" />
                    <ui:PasswordBox x:Name="PasswordInput"
                                    Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    RevealButtonEnabled="True"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="确认密码" Style="{StaticResource FieldLabelStyle}" />
                        <ui:PasswordBox x:Name="ConfirmPasswordInput"
                                        Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        RevealButtonEnabled="True"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>

                    <CheckBox Content="保存登录状态"
                              IsChecked="{Binding RememberLogin, Mode=TwoWay}"
                              Margin="0,16,0,0"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource DangerTextStyle}"
                               Margin="0,12,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:ProgressRing Width="16"
                                         Height="16"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                         Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource MutedTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ui:Button Content="登录"
                               Appearance="Primary"
                               Command="{Binding LoginCommand}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                               HorizontalAlignment="Stretch"
                               Height="36"
                               Margin="0,20,0,0"
                               Visibility="{Binding IsLoginMode, Converter={StaticResource BoolToVisibility}}" />

                    <ui:Button Content="注册并登录"
                               Appearance="Primary"
                               Command="{Binding RegisterCommand}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                               HorizontalAlignment="Stretch"
                               Height="36"
                               Margin="0,20,0,0"
                               Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibility}}" />

                    <ui:HyperlinkButton Content="没有账号？立即注册"
                                        Command="{Binding ShowRegisterCommand}"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding IsLoginMode, Converter={StaticResource BoolToVisibility}}" />
                    <ui:HyperlinkButton Content="已有账号？返回登录"
                                        Command="{Binding ShowLoginCommand}"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>
        </Border>
    </DockPanel>
</ui:FluentWindow>
